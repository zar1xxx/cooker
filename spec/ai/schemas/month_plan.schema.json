{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "month_plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "days"
  ],
  "properties": {
    "days": {
      "type": "array",
      "minItems": 1,
      "maxItems": 7,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "date",
          "title",
          "dish_type",
          "difficulty",
          "main_ingredients"
        ],
        "properties": {
          "date": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "title": {
            "type": "string"
          },
          "dish_type": {
            "type": "string",
            "enum": [
              "soup",
              "main",
              "side",
              "salad",
              "breakfast",
              "snack",
              "baking",
              "dessert",
              "drink",
              "preserve"
            ]
          },
          "difficulty": {
            "type": "string",
            "enum": [
              "easy",
              "medium",
              "hard"
            ]
          },
          "main_ingredients": {
            "type": "array",
            "minItems": 1,
            "maxItems": 4,
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
