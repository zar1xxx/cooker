{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "full_recipe",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "title",
    "dish_type",
    "difficulty",
    "cuisine",
    "total_minutes",
    "active_minutes",
    "servings",
    "description",
    "ingredients",
    "steps"
  ],
  "properties": {
    "title": {
      "type": "string",
      "minLength": 2,
      "maxLength": 80
    },
    "dish_type": {
      "type": "string",
      "enum": [
        "soup",
        "main",
        "side",
        "salad",
        "breakfast",
        "snack",
        "baking",
        "dessert",
        "drink",
        "preserve"
      ]
    },
    "difficulty": {
      "type": "string",
      "enum": [
        "easy",
        "medium",
        "hard"
      ]
    },
    "cuisine": {
      "type": "string",
      "maxLength": 40
    },
    "total_minutes": {
      "type": "integer",
      "minimum": 5,
      "maximum": 600
    },
    "active_minutes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 600
    },
    "servings": {
      "type": "integer",
      "minimum": 1,
      "maximum": 12
    },
    "description": {
      "type": "string",
      "maxLength": 300
    },
    "ingredients": {
      "type": "array",
      "minItems": 1,
      "maxItems": 25,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "amount",
          "unit",
          "is_optional"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "amount": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "unit": {
            "type": "string",
            "enum": [
              "g",
              "kg",
              "ml",
              "l",
              "pcs",
              "tbsp",
              "tsp",
              "cup",
              "pinch",
              "to_taste"
            ]
          },
          "is_optional": {
            "type": "boolean"
          },
          "note": {
            "type": "string",
            "maxLength": 80
          }
        }
      }
    },
    "steps": {
      "type": "array",
      "minItems": 2,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "text",
          "timer_seconds"
        ],
        "properties": {
          "text": {
            "type": "string",
            "minLength": 3,
            "maxLength": 240
          },
          "timer_seconds": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0,
            "maximum": 36000
          },
          "tip": {
            "type": "string",
            "maxLength": 160
          }
        }
      }
    }
  }
}
